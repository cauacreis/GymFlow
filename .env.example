# ==============================================================================
# GymFlow - Environment Variables Template (.env.example)
# NUNCA insira credenciais reais neste arquivo (ele é público no Git).
# Preencha suas credenciais reais no arquivo .env.local (ignorado pelo Git).
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# App URL & CORS
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# JWT & Authentication Secret (Gerar com: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# ==============================================================================
# MERCADO PAGO — ONDE E COMO CADASTRAR SUAS CREDENCIAIS:
# 1. Acesse o Painel de Desenvolvedores: https://www.mercadopago.com.br/developers/panel/app
# 2. Crie uma aplicação (ex: "GymFlow") e vá em "Credenciais de Teste" (Sandbox).
# 3. Copie o Access Token e a Public Key para o seu arquivo .env.local
# 4. Para Produção na Vercel: adicione estas mesmas chaves (com credenciais de produção APP_USR-)
#    em Vercel > Settings > Environment Variables.
# ==============================================================================
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MP_WEBHOOK_SECRET=your_mercadopago_webhook_secret_hmac

# Nomes alternativos suportados automaticamente pelo GymFlow:
# MP_ACCESS_TOKEN_SANDBOX=TEST-xxxx
# MP_ACCESS_TOKEN_PRODUCTION=APP_USR-xxxx
# NEXT_PUBLIC_MP_PUBLIC_KEY_SANDBOX=TEST-xxxx
# NEXT_PUBLIC_MP_PUBLIC_KEY_PRODUCTION=APP_USR-xxxx

# Free AI Services (Hugging Face / Groq / Google Gemini Free Tier / Fallback)
FREE_AI_PROVIDER=fallback
FREE_AI_API_KEY=your_free_ai_api_key_here

# Supabase Cloud Database & Auth (https://supabase.com/dashboard)
# Obtenha em: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ==============================================================================
# GOOGLE OAUTH & PROVEDORES SOCIAIS — GUIA DE CONFIGURAÇÃO (SUPABASE DASHBOARD):
# ==============================================================================
# O GymFlow oferece autenticação via Google OAuth sem expor segredos no front-end.
# As credenciais (Client ID & Secret) são configuradas DIRETAMENTE no Supabase:
#
# 1. Obtenha as credenciais no Google Cloud Console:
#    - Acesse: https://console.cloud.google.com/apis/credentials
#    - Crie um projeto ou selecione um existente (ex: "GymFlow").
#    - Vá em "Credenciais" > "Criar Credenciais" > "ID do cliente OAuth".
#    - Tipo de aplicativo: "Aplicativo da Web" (Web Application).
#    - "Origens JavaScript autorizadas":
#        http://localhost:3000
#        https://gymflow-weld.vercel.app
#    - "URIs de redirecionamento autorizados" (Callback URL do Supabase):
#        https://<YOUR-PROJECT-REF>.supabase.co/auth/v1/callback
#    - Clique em Criar e anote seu Client ID e Client Secret.
#
# 2. Ative o provedor Google no Supabase Dashboard:
#    - Acesse: https://supabase.com/dashboard/project/<YOUR-PROJECT-REF>/auth/providers
#    - Localize "Google" e marque "Enable Google provider".
#    - Cole o "Client ID" e "Client Secret" obtidos no Google Cloud.
#    - Salve as alterações.
#
# 3. Configure as URLs de Redirecionamento no Supabase:
#    - Vá em: Authentication > URL Configuration
#    - Site URL: https://gymflow-weld.vercel.app
#    - Redirect URLs (adicione ambas):
#        http://localhost:3000/**
#        https://gymflow-weld.vercel.app/**
# ==============================================================================

# Database Connection Direct (Opcional - para migrations diretas)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Optional Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
