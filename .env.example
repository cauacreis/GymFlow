# ==============================================================================
# GymFlow - Environment Variables Template (.env.example)
# NUNCA insira credenciais reais neste arquivo.
# Copie este arquivo para .env.local em desenvolvimento e preencha com suas chaves de teste.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# App URL & CORS
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# JWT & Authentication Secret (Gerar com: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# Mercado Pago (Sandbox vs Produção)
# Obtenha suas credenciais no painel de desenvolvedores do Mercado Pago
NEXT_PUBLIC_MP_PUBLIC_KEY_SANDBOX=TEST-00000000-0000-0000-0000-000000000000
MP_ACCESS_TOKEN_SANDBOX=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_WEBHOOK_SECRET=your_mercadopago_webhook_secret_hmac

# Produção (Deixar vazio ou configurar via painel seguro de CI/CD / Vercel)
# NEXT_PUBLIC_MP_PUBLIC_KEY_PRODUCTION=APP_USR-xxxx
# MP_ACCESS_TOKEN_PRODUCTION=APP_USR-xxxx

# Free AI Services (Hugging Face / Groq / Google Gemini Free Tier / Fallback)
FREE_AI_PROVIDER=fallback
FREE_AI_API_KEY=your_free_ai_api_key_here

# Supabase Cloud Database & Auth (https://supabase.com/dashboard)
# Obtenha em: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Database Connection Direct (Opcional - para ORMs ou migrations diretas)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Optional Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

